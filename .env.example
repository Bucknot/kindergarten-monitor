# STT Provider Settings
# Options: gladia | deepgram | openai_compatible | mock
STT_PROVIDER=mock

# Gladia API Key (https://app.gladia.io - €50 free credit)
GLADIA_API_KEY=

# Deepgram API Key (https://console.deepgram.com)
DEEPGRAM_API_KEY=

# OpenAI-Compatible / Whisper STT (e.g. OpenAI, Groq, LemonFox, Local)
OPENAI_COMPATIBLE_STT_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_STT_API_KEY=
OPENAI_COMPATIBLE_STT_MODEL=whisper-1

# LLM Provider for Hebrew Kindergarten Report Generation
# Options: openrouter | openai | anthropic | gemini | mock
LLM_PROVIDER=mock

# OpenRouter Settings (Access Claude, GPT-4o, Llama 3, Gemini, etc. via OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Standard OpenAI / Anthropic / Gemini Keys
OPENAI_API_KEY=
LLM_MODEL=gpt-4o
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Server & Storage Configuration
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./storage/db/kindergarten_monitor.db
STORAGE_PATH=./storage
